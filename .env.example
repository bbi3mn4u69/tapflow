# DEMO / NO REAL MONEY. Copy to .env and generate your own local secrets.
APP_ENV=development
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080
API_HOST=0.0.0.0
API_PORT=8080
DEMO_MODE=true
DATABASE_URL=jdbc:postgresql://localhost:5432/tapflow
DATABASE_USER=tapflow
DATABASE_PASSWORD=REPLACE_WITH_LOCAL_DEV_PASSWORD
# Local Docker fallback only; kept separate from a hosted database password.
LOCAL_DATABASE_PASSWORD=REPLACE_WITH_LOCAL_DOCKER_PASSWORD
DATABASE_POOL_SIZE=5
# Demo seeding only, read by infra/scripts/seed-demo.sh. Never reuse the database password.
SEED_OWNER_PASSWORD=REPLACE_WITH_OWNER_PASSWORD
SEED_OPERATOR_PASSWORD=REPLACE_WITH_OPERATOR_PASSWORD
SEED_CUSTOMER_PASSWORD=REPLACE_WITH_CUSTOMER_PASSWORD
JWT_SIGNING_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES
JWT_ISSUER=tapflow-local
JWT_AUDIENCE=tapflow-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
PAYMENT_INTENT_TTL_SECONDS=90
PAIRING_CODE_TTL_SECONDS=600
DEMO_INITIAL_BALANCE_MINOR=10000
DEMO_CUSTOMER_REGISTRATION_ENABLED=false
DEMO_RESET_ENABLED=false
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=/api/v1
