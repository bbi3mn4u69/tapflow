{
    admin off
    auto_https off
}
:{$PORT:8080} {
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        Cache-Control no-store
    }
    handle /healthz {
        respond "ready" 200
    }
    handle /health/* {
        respond "Not found" 404
    }
    handle /api/* {
        reverse_proxy {$API_UPSTREAM:api:8080}
    }
    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
